# Ignora a pasta de dependências
node_modules/

# Ignora arquivos de ambiente
.env

# Ignora arquivos de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignora diretórios de build/compilação
dist/
build/
tmp/
temp/

# Ignora o diretório de testes de cobertura (caso use Jest)
coverage/

# Ignora arquivos do sistema
.DS_Store
Thumbs.db

# Ignora configurações da IDE
.vscode/
.idea/

# Ignora pastas do sistema operacional
*.swp
*.swo
